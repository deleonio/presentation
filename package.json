{
	"name": "@public-ui/presentation",
	"version": "4.3.0-rc.7",
	"description": "This package contains presentation samples for the KoliBri/Public UI",
	"license": "EUPL-1.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/public-ui/kolibri"
	},
	"scripts": {
		"build": "vite build",
		"build:deps": "pnpm --filter @public-ui/presentation^... build",
		"format": "prettier --check src",
		"lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:tsc",
		"lint:eslint": "eslint src",
		"lint:stylelint": "stylelint \"src/**/*.{css,scss}\"",
		"lint:tsc": "tsc --noemit",
		"prebuild": "kolibri-copy-assets --dest public/assets @public-ui/components @public-ui/theme-bwst @public-ui/theme-default @public-ui/theme-desy @public-ui/theme-ecl @public-ui/theme-kern @public-ui/sample-react",
		"prepare": "pnpm prebuild",
		"serve": "vite",
		"start": "vite --open",
		"test:e2e": "playwright test",
		"unused": "knip"
	},
	"dependencies": {
		"@public-ui/components": "4.3.0-4ee0734eadda2c69344a4386b7d580fd54e4ddca.0",
		"@public-ui/react-v19": "4.3.0-4ee0734eadda2c69344a4386b7d580fd54e4ddca.0",
		"@public-ui/sample-react": "4.3.0-4ee0734eadda2c69344a4386b7d580fd54e4ddca.0",
		"@public-ui/theme-bwst": "4.3.0-4ee0734eadda2c69344a4386b7d580fd54e4ddca.0",
		"@public-ui/theme-default": "4.3.0-4ee0734eadda2c69344a4386b7d580fd54e4ddca.0",
		"@public-ui/theme-desy": "4.3.0-4ee0734eadda2c69344a4386b7d580fd54e4ddca.0",
		"@public-ui/theme-ecl": "4.3.0-4ee0734eadda2c69344a4386b7d580fd54e4ddca.0",
		"@public-ui/theme-kern": "4.3.0-4ee0734eadda2c69344a4386b7d580fd54e4ddca.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router": "7.18.2"
	},
	"devDependencies": {
		"@playwright/test": "1.60.0",
		"@types/node": "26.1.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@unocss/preset-mini": "66.7.5",
		"@unocss/vite": "66.7.5",
		"@vitejs/plugin-react": "6.0.5",
		"adopted-style-sheets": "1.1.9-rc.25",
		"eslint": "9.39.5",
		"knip": "6.29.0",
		"prettier": "3.9.6",
		"prettier-plugin-organize-imports": "4.3.0",
		"stylelint": "17.14.1",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"vite": "8.1.5"
	},
	"files": [
		"dist",
		"public",
		"src",
		"index.html",
		"tsconfig.json",
		"unocss.config.ts",
		"vite.config.ts"
	]
}
